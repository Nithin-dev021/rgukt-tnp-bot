# Telegram Settings
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=@your_channel_username_or_id

# Polling & Behaviour
POLL_INTERVAL_SECONDS=300
SEND_ALL_ON_FIRST_RUN=false

# WhatsApp Settings (Optional - Green-API)
ENABLE_WHATSAPP=false
GREENAPI_INSTANCE_ID=YOUR_GREENAPI_INSTANCE_ID_HERE
GREENAPI_API_TOKEN=YOUR_GREENAPI_API_TOKEN_HERE
GREENAPI_HOST=https://7107.api.greenapi.com
WHATSAPP_CHAT_ID=YOUR_WHATSAPP_GROUP_ID_HERE
